# No credentials. Copy to .env and choose explicit paths.
SYNC_PORT=8080
SYNC_DATA_DIR=./data
SYNC_CONFIG_FILE=./config/filesystem.toml
# For docker-compose.s3.yml use config/s3.toml and provision private readable files:
# S3_ACCESS_KEY_FILE=./secrets/s3-access-key
# S3_SECRET_KEY_FILE=./secrets/s3-secret-key
